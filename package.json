{
  "name": "pano-grid-tour",
  "version": "0.1.0",
  "description": "React editor and viewer for 360° panorama tours laid out as rooms on a grid, built on Photo Sphere Viewer",
  "license": "MIT",
  "author": "Roman Kolychev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeMoZ/pano-grid-tour.git"
  },
  "keywords": [
    "360",
    "panorama",
    "virtual-tour",
    "photo-sphere-viewer",
    "react",
    "floor-plan"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "dev:host": "vite --config demo/vite.config.ts --host",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
